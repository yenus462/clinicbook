{
  "info": {
    "name": "ClinicBook API",
    "description": "Set the collection variables first: baseUrl (default http://localhost:5000/api), patientEmail, patientPassword, adminEmail, adminPassword. Run 'Login as patient' and 'Login as admin' first. Tokens are saved automatically into variables and are never stored in this file.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5000/api" },
    { "key": "patientEmail", "value": "patient@example.com" },
    { "key": "patientPassword", "value": "" },
    { "key": "adminEmail", "value": "admin@clinicbook.com" },
    { "key": "adminPassword", "value": "" },
    { "key": "patientToken", "value": "" },
    { "key": "adminToken", "value": "" },
    { "key": "appointmentId", "value": "" }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Health check",
          "request": { "method": "GET", "url": "{{baseUrl}}/health" }
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/auth/register",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Test User\",\n  \"email\": \"testuser@example.com\",\n  \"phone\": \"0911000003\",\n  \"password\": \"ChangeMe1234\"\n}"
            }
          }
        },
        {
          "name": "Login as patient",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "if (body.token) { pm.collectionVariables.set('patientToken', body.token); }",
                  "pm.test('login worked', function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{patientEmail}}\",\n  \"password\": \"{{patientPassword}}\"\n}"
            }
          }
        },
        {
          "name": "Login as admin",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "if (body.token) { pm.collectionVariables.set('adminToken', body.token); }",
                  "pm.test('login worked', function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}"
            }
          }
        },
        {
          "name": "Current user (patient)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{patientToken}}" }],
            "url": "{{baseUrl}}/auth/me"
          }
        }
      ]
    },
    {
      "name": "Public",
      "item": [
        { "name": "List specialties", "request": { "method": "GET", "url": "{{baseUrl}}/specialties" } },
        { "name": "List doctors", "request": { "method": "GET", "url": "{{baseUrl}}/doctors" } },
        { "name": "Doctor 1", "request": { "method": "GET", "url": "{{baseUrl}}/doctors/1" } },
        {
          "name": "Free slots (change the date)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/doctors/1/slots?date=2026-11-16",
              "host": ["{{baseUrl}}"],
              "path": ["doctors", "1", "slots"],
              "query": [{ "key": "date", "value": "2026-11-16" }]
            }
          }
        }
      ]
    },
    {
      "name": "Patient appointments",
      "item": [
        {
          "name": "Book (change the date)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "if (body.appointment) { pm.collectionVariables.set('appointmentId', body.appointment.id); }"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{patientToken}}" }
            ],
            "url": "{{baseUrl}}/appointments",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"doctorId\": 1,\n  \"date\": \"2026-11-16\",\n  \"startTime\": \"09:00\",\n  \"reason\": \"Check-up\"\n}"
            }
          }
        },
        {
          "name": "My appointments",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{patientToken}}" }],
            "url": "{{baseUrl}}/appointments/me"
          }
        },
        {
          "name": "Reschedule (change the date)",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{patientToken}}" }
            ],
            "url": "{{baseUrl}}/appointments/{{appointmentId}}/reschedule",
            "body": { "mode": "raw", "raw": "{\n  \"date\": \"2026-11-17\",\n  \"startTime\": \"10:00\"\n}" }
          }
        },
        {
          "name": "Cancel",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Authorization", "value": "Bearer {{patientToken}}" }],
            "url": "{{baseUrl}}/appointments/{{appointmentId}}/cancel"
          }
        }
      ]
    },
    {
      "name": "Admin",
      "item": [
        {
          "name": "Stats",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": "{{baseUrl}}/admin/stats"
          }
        },
        {
          "name": "List appointments",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/admin/appointments?page=1&pageSize=10",
              "host": ["{{baseUrl}}"],
              "path": ["admin", "appointments"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "pageSize", "value": "10" }
              ]
            }
          }
        },
        {
          "name": "Set appointment status",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "url": "{{baseUrl}}/admin/appointments/{{appointmentId}}/status",
            "body": { "mode": "raw", "raw": "{\n  \"status\": \"CANCELLED\"\n}" }
          }
        },
        {
          "name": "List doctors (admin)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": "{{baseUrl}}/admin/doctors"
          }
        },
        {
          "name": "List specialties (admin)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": "{{baseUrl}}/admin/specialties"
          }
        }
      ]
    }
  ]
}