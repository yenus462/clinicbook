# Copy this file to ".env" and fill in your own values.
# The real .env file is never committed to Git.

DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/clinicbook?schema=public"
ADMIN_PASSWORD="choose-a-strong-admin-password"
PORT="5000"
FRONTEND_URL="http://localhost:5173"

# At least 32 random characters. Generate one with:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="replace-with-a-long-random-secret"
JWT_EXPIRES_IN="7d"

# Optional. The clinic's local time zone (default: Africa/Addis_Ababa)
CLINIC_TIME_ZONE="Africa/Addis_Ababa"

# Optional. Login attempts per 15 minutes (default 10). Raise only for local testing.
AUTH_RATE_LIMIT="10"